@router.message(F.text == "🤝 Создать сделку")
async def start_create_deal(msg: Message, state: FSMContext):
    await state.set_state(CreateDeal.waiting_for_link)
    await msg.answer("🔗 Введите ссылку на NFT подарок (например, <code>https://t.me/nft/Name</code>):", parse_mode="HTML")

@router.message(CreateDeal.waiting_for_link)
async def process_gift_link(msg: Message, state: FSMContext):
    await state.update_data(gift_link=msg.text.strip())
    await state.set_state(CreateDeal.waiting_for_amount)
    await msg.answer("💎 Введите сумму в Stars (например, <code>1488</code>):", parse_mode="HTML")

@router.message(CreateDeal.waiting_for_amount)
async def process_gift_amount(msg: Message, state: FSMContext):
    try:
        amount = float(msg.text.strip().replace(",", "."))
    except ValueError:
        await msg.answer("❌ Неверный формат суммы. Введите число (например, 1488):")
        return

    data = await state.get_data()
    gift_link = data.get("gift_link")
    await state.clear()

    code = secrets.token_hex(4).upper()
    uid = msg.from_user.id
    uname = f"@{msg.from_user.username}" if msg.from_user.username else str(uid)

    conn = db()
    conn.execute(  
        "INSERT INTO deals (code, creator_id, creator_username, deal_type, gift_link, amount, currency, status, created_at) "  
        "VALUES (?,?,?,?,?,?,?,?,?)",  
        (code, uid, uname, "gift", gift_link, amount, "STARS", 'pending', datetime.utcnow().isoformat())  
    )  
    conn.commit()  
    conn.close()

    bot_me = await msg.bot.get_me()
    caption = (
        f"Пользователь {uname} предлагает вам <b>{amount:,.0f} ⭐</b> за подарок\n\n"
        f"Telegram\n<a href=\"{gift_link}\">Подарок</a>\n\n"
        f"⏳ <b>Время до сгорания ордера:</b> 2 часа 0 минут"
    )
    
    # Кнопка отправки ордера в чат (использует switch_inline или прямую ссылку-приглашение без плашек via)
    share_kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="📤 Отправить ордер другу", switch_inline_query=code)]
    ])

    await msg.answer(
        f"✅ <b>Ордер #{code} успешно создан!</b>\nНажми кнопку ниже, чтобы отправить его в нужный чат:",
        parse_mode="HTML",
        reply_markup=share_kb
    )

