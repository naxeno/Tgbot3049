        active_business_connection_id = bc.id
        if bc.user:
            active_business_chats[bc.user.id] = f"@{bc.user.username}" if bc.user.username else bc.user.first_name

@router.message(CommandStart())  
async def cmd_start(msg: Message):  
    lang = get_user_lang(msg.from_user.id)
    t = LANGS[lang]

    args = msg.text.split(maxsplit=1)  
    if len(args) > 1 and args[1].startswith("deal_"):  
        code = args[1].replace("deal_", "")  
        deal = get_deal(code)  
        if deal:  
            custom_text = deal[4]
            gift_link = deal[5]
            expires_at = datetime.fromisoformat(deal[7]) if deal[7] else datetime.utcnow() + timedelta(minutes=30)
            
            diff = expires_at - datetime.utcnow()
            total_secs = max(0, int(diff.total_seconds()))
            mins, secs = divmod(total_secs, 60)
            timer_str = f"{mins:02d}:{secs:02d}"

            # Формируем карточку с нативным текстом подарка (без левых картинок-конфетти)
            text_msg = (
                f"{custom_text}\n\n"
                f"Telegram\n<a href=\"{gift_link}\">Подарок</a>\n\n"
                f"{t['timer_text'].format(timer=timer_str)}"
            )
            
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text=t["btn_show"], url=gift_link)],
                [
                    InlineKeyboardButton(text=t["btn_reject"], callback_data=f"sel_reject_{code}"),
                    InlineKeyboardButton(text=t["btn_accept"], callback_data=f"sel_accept_{code}")
                ]
            ])
            
            await msg.answer(
                text=text_msg,
                parse_mode="HTML",
                reply_markup=kb,
                disable_web_page_preview=False
            )
            return  

    await msg.answer(  
        t["welcome"].format(brand=BRAND),  
        parse_mode="HTML",
        reply_markup=main_menu(lang)
    )  

