                caption=caption,
                parse_mode="HTML",
                reply_markup=kb
            )
            return  

    await msg.answer(  
        f"🏦 Добро пожаловать в <b>{BRAND}</b>!\n\nНажми кнопку ниже, чтобы создать сделку.",  
        parse_mode="HTML",
